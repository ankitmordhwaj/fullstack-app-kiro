# =============================================================================
# TaskFlow — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose db service)
# -----------------------------------------------------------------------------
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=taskflow

# -----------------------------------------------------------------------------
# Flask backend
# -----------------------------------------------------------------------------
# Full SQLAlchemy connection string — references the db service defined above.
DATABASE_URL=postgresql://taskflow:changeme@db:5432/taskflow

# Secret key used to sign JWT tokens. Use a long, random string in production.
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Flask run mode: "development" enables debug mode and hot reload.
FLASK_ENV=development

# -----------------------------------------------------------------------------
# React frontend (Vite)
# VITE_ prefix is required for Vite to expose variables to the browser bundle.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Atlassian MCP (Jira & Confluence integration)
# Used by .kiro/settings/mcp.json for the mcp-atlassian server
# -----------------------------------------------------------------------------
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USERNAME=your-email@example.com
CONFLUENCE_API_TOKEN=your-confluence-api-token
