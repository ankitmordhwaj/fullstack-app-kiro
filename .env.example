# =============================================================================
# TaskFlow — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose db service)
# -----------------------------------------------------------------------------
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=taskflow

# -----------------------------------------------------------------------------
# Flask backend
# -----------------------------------------------------------------------------
# Full SQLAlchemy connection string — references the db service defined above.
DATABASE_URL=postgresql://taskflow:changeme@db:5432/taskflow

# Secret key used to sign JWT tokens. Use a long, random string in production.
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Flask run mode: "development" enables debug mode and hot reload.
FLASK_ENV=development

# -----------------------------------------------------------------------------
# React frontend (Vite)
# VITE_ prefix is required for Vite to expose variables to the browser bundle.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
